# Backend taban adresi (Fusion + CMS).
#  - Prod (Coolify): Dockerfile varsayılanı https://aiapi.diagvoice.com. Coolify'da "Build Variable"
#    VITE_API_BASE ile değiştirilebilir. Vite bunu build sırasında bundle'a gömer.
#  - Geliştirme: boş bırakın → "/api" kullanılır, Vite proxy /api/* → DEV_BACKEND_URL.
# VITE_API_BASE=https://aiapi.diagvoice.com

# Geliştirmede Vite proxy'nin yönlendireceği backend (varsayılan http://127.0.0.1:8085)
# DEV_BACKEND_URL=http://127.0.0.1:8085

VITE_API_TIMEOUT_MS=600000
