# Konteyner /app içinde okunur (docker-compose env_file veya volume ile).
# Kök .env (MONGO, JWT) ayrı — burada çıkarım ve fusion ayarları.

# --- STT (voice_to_text) ---
# VOICE_TO_TEXT_MODEL=openai/whisper-base
# VOICE_TO_TEXT_MAX_AUDIO_SEC=0
# STT_CHUNK_SEC=25
# STT_NUM_BEAMS=1
# STT_MAX_NEW_TOKENS=256
# STT_MAX_PARALLEL_CHUNKS=1
# VOICE_TO_TEXT_USE_INFER_LOCK=1

# --- Ses emosyonu ---
# AUDIO_N_SEGMENTS=3
# AUDIO_ENABLE_VAD=1
# AUDIO_VAD_MAX_KEEP_SEC=30
# VOICE_SENTIMENT_USE_INFER_LOCK=1

# --- Depresyon ---
# DEPRESSION_MAX_SEGMENTS=12
# DEPRESSION_SEGMENT_SEC=8
# DEPRESSION_HOP_SEC=4
# DEPRESSION_INFER_BATCH_SIZE=4
# DEPRESSION_USE_INFER_LOCK=1

# --- Hastalık (disease) ---
# DISEASE_MAX_SEC=30
# DISEASE_USE_INFER_LOCK=1

# --- Mental fitness ---
# MENTAL_FITNESS_USE_INFER_LOCK=1

# --- Yaş-cinsiyet ---
# AGE_GENDER_USE_READY_GENDER_MODEL=1
# AGE_GENDER_USE_INFER_LOCK=1

# --- Metin duygusu ---
# TEXT_SENTIMENT_MODEL=kaixkhazaki/turkish-sentiment
# TEXT_SENTIMENT_USE_INFER_LOCK=1

# --- Fusion ---
# FUSION_PROXY_MAX_MEMORY_BYTES=8388608
# FUSION_HTTP_TIMEOUT_SEC=900

# --- Benchmark — kapatmak için kök .env veya burada boş ---
# INFERENCE_API_URL=
