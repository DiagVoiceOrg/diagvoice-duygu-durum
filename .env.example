# =============================================================================
# Depo kökü — tek şablon (.env olarak kopyalayıp doldurun).
# diagvoice-backend/.env kullanılmaz; docker-compose env_file: .env
# =============================================================================

# --- CMS / Mongo (zorunlu) ---
MONGO_URI=mongodb+srv://USER:PASS@cluster.example.net/diagvoice_cms?retryWrites=true
MONGO_DB=diagvoice_cms

JWT_SECRET=change-me
CMS_ADMIN_EMAIL=admin@localhost
CMS_ADMIN_PASSWORD=change-me
# bcrypt en fazla 72 bayt; girişte aynı kural.

# CMS kapalı: CMS_ENABLED=0

# --- Dahili servis URL'leri (Docker içi varsayılanlar; host’ta değiştirin) ---
# VOICE_TO_TEXT_URL=http://127.0.0.1:8051/transcribe
# TEXT_TO_SENTIMENT_URL=http://127.0.0.1:8050/analyze
# VOICE_TO_SENTIMENT_URL=http://127.0.0.1:8052/analyze-audio
# DISEASE_SERVICE_URL=http://127.0.0.1:8054/analyze-disease
# MENTAL_FITNESS_URL=http://127.0.0.1:8055/analyze-mental
# AGE_GENDER_URL=http://127.0.0.1:8056/analyze-age-gender
# DEPRESSION_SERVICE_URL=http://127.0.0.1:8057/analyze-depression

# --- Fusion ---
# FUSION_W_TEXT=0.5
# AUDIO_VALENCE_WEIGHTS=-1.0,-0.6,1.0,-0.8
# DYNAMIC_FUSION=1
# W_TEXT_MIN=0.2
# W_TEXT_MAX=0.8
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# FUSION_HTTP_TIMEOUT_SEC=900
# FUSION_HTTP_READ_TIMEOUT_SEC=900
# FUSION_HTTP_CONNECT_TIMEOUT_SEC=30
# FUSION_PROXY_MAX_MEMORY_BYTES=8388608
# FUSION_UPSTREAM_CONNECT_RETRIES=10
# FUSION_UPSTREAM_RETRY_DELAY_SEC=1
# DIAGVOICE_LOG_LEVEL=INFO

# --- STT (voice_to_text) ---
# VOICE_TO_TEXT_MODEL=openai/whisper-base
# VOICE_TO_TEXT_MAX_AUDIO_SEC=0
# STT_CHUNK_SEC=25
# STT_NUM_BEAMS=1
# STT_MAX_NEW_TOKENS=256
# STT_MAX_PARALLEL_CHUNKS=1
# VOICE_TO_TEXT_USE_INFER_LOCK=1

# --- Ses emosyonu ---
# AUDIO_SENTIMENT_CKPT=wavlm_v6_multicrop_ema_best.pt
# AUDIO_SENTIMENT_BACKBONE=microsoft/wavlm-base-plus
# AUDIO_N_SEGMENTS=5
# AUDIO_ENABLE_VAD=1
# AUDIO_VAD_TOP_DB=25
# AUDIO_VAD_MAX_KEEP_SEC=30
# VOICE_SENTIMENT_USE_INFER_LOCK=1

# --- Depresyon ---
# DEPRESSION_MAX_SEGMENTS=20
# DEPRESSION_SEGMENT_SEC=8
# DEPRESSION_HOP_SEC=4
# DEPRESSION_INFER_BATCH_SIZE=4
# DEPRESSION_THRESHOLD=0.5
# DEPRESSION_USE_INFER_LOCK=1

# --- Hastalık ---
# DISEASE_MODEL_DIR=/app/models/usye
# DISEASE_MAX_SEC=30
# DISEASE_USE_INFER_LOCK=1

# --- Mental fitness ---
# MENTAL_FITNESS_MODEL_PATH=/app/models/extratreesclassifier.joblib
# MENTAL_FITNESS_USE_INFER_LOCK=1
# DEEPSEEK_TRANSCRIPT_VALIDATION=0
# DEEPSEEK_API_KEY=
# REQUIRE_DEEPSEEK_TRANSCRIPT_VALIDATION=0
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# --- Yaş-cinsiyet ---
# AGE_GENDER_USE_READY_GENDER_MODEL=1
# AGE_GENDER_USE_INFER_LOCK=1

# --- Metin duygusu ---
# TEXT_SENTIMENT_MODEL=kaixkhazaki/turkish-sentiment
# TEXT_SENTIMENT_USE_INFER_LOCK=1

# --- Türkçe psik HF (mental_fitness ses servisinden ayrı; /analyze-fused ZİNCİRİNE DAHİL DEĞİL) ---
# Dışarıda yalnızca :8085 açıksa POST /analyze-turkish-psych-signals için Fusion'un iç servise proxy yapması gerekir:
# TURKISH_PSYCH_CLASSIFIER_URL=http://127.0.0.1:8058/analyze
# Yalnız bu proxy'yi kapatmak için (iç portu dışarı açtıysanız): TURKISH_PSYCH_CLASSIFIER_URL=
# TURKISH_PSYCH_CLASSIFIER_PORT=8058
# TURKISH_PSYCH_MODEL_DIR=/app/mental_fitness_turkish_psych_classifier
# TURKISH_PSYCH_WEIGHTS_PATH=/app/models/mental-fitness-forgpt.safetensors
# TURKISH_PSYCH_LABEL_MAPS=/app/mental_fitness_turkish_psych_classifier/label_maps.json
# TURKISH_PSYCH_CATEGORY_NAMES_TR=/app/mental_fitness_turkish_psych_classifier/psych_category_names_tr.json
# TURKISH_PSYCH_USE_INFER_LOCK=1
# Admin diagnostics: varsayılan http://127.0.0.1:8058/health — kapatmak için boş: TURKISH_PSYCH_HEALTH_URL=

# --- Benchmark (iş sağlığı / inference_api Flask) ---
# INFERENCE_API_URL=http://127.0.0.1:8053
# Kapatmak için: INFERENCE_API_URL=
# DIAGVOICE_MODEL=/app/models/is-sagligi.joblib
# DIAGVOICE_BENCHMARK_CONFIG=/app/inference_api/config.docker.yaml
# DIAGVOICE_STRICT_FEATURES=1

# --- Admin diagnostics (models-health) ---
# DIAGNOSTICS_HEALTH_CONNECT_SEC=4
# DIAGNOSTICS_HEALTH_READ_SEC=12

# --- Vite (app/.env — frontend ayrı dosya) ---
# VITE_API_URL=http://localhost:8085/analyze-fused
# VITE_CMS_API_URL=http://localhost:8085
