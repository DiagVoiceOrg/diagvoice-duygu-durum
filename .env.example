# Docker Compose backend için — bu dosyayı `.env` olarak kopyalayıp doldurun.
# MongoDB compose içinde çalışmaz; prod / harici sunucu URI’si kullanılır.
#
# Kod volume: ./diagvoice-backend -> konteyner /app (anında senkron). Backend’de uvicorn/flask hot reload yok.

MONGO_URI=mongodb+srv://USER:PASS@cluster.example.net/diagvoice_cms?retryWrites=true
MONGO_DB=diagvoice_cms

JWT_SECRET=change-me
CMS_ADMIN_EMAIL=admin@localhost
CMS_ADMIN_PASSWORD=change-me
# bcrypt en fazla 72 bayt: sunucu parolayı bu sınıra indirir; girişte de aynı kural uygulanır.

# İlk açılışta admin kaydı `users` koleksiyonuna yazılır (çoğul — "user" değil).
# Giriş: POST /auth/login body { "email": "<CMS_ADMIN_EMAIL>", "password": "<CMS_ADMIN_PASSWORD>" }

# CMS kapalı: CMS_ENABLED=0

# Portlar: Fusion dışarı 8085; konteyner içi mikro servisler 8050–8057 (Dockerfile ENV).

# Fusion: upstream (mikro servis) kapalıyken yeniden deneme — çok yüksek değer isteği gereksiz uzatır.
# FUSION_UPSTREAM_CONNECT_RETRIES=10
# FUSION_UPSTREAM_RETRY_DELAY_SEC=1

# Fusion + depresyon/ses emosyon logları (INFO: aşama süreleri). DEBUG daha gürültülü.
# DIAGVOICE_LOG_LEVEL=INFO

# Docker imajı: OMP/MKL tek iş parçacığı — aynı CPU’da çoklu PyTorch süreci için taşmayı azaltır.

# Mental fitness (diagvoice-backend/.env): DeepSeek transkript doğrulama — 0 ile LLM kapalı.
# DEEPSEEK_TRANSCRIPT_VALIDATION=0

# Mikro servis hız ayarları (tam liste): diagvoice-backend/.env.example

# Vite (app/.env)
# VITE_API_URL=http://localhost:8085/analyze-fused
# VITE_CMS_API_URL=http://localhost:8085
