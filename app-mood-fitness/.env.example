# Fusion kök host — /analyze-fused DEĞİL (tüm modelleri çalıştırmaz).
# Bu FE yalnızca şu proxy uçlarını çağırır:
#   POST /analyze-voice-to-text
#   POST /analyze-voice-sentiment
#   POST /analyze-mental-fitness
#   POST /analyze-mental-fitness/validate-transcript-meaning
VITE_FUSION_ORIGIN=https://aiapi.diagvoice.com

# Yerel geliştirme:
# VITE_FUSION_ORIGIN=http://localhost:8085

# İsteğe bağlı zaman aşımı (ms)
# VITE_API_TIMEOUT_MS=600000
# VITE_TRANSCRIPT_VALIDATE_MS=90000
